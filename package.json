{
  "name": "usts-jwgl",
  "version": "1.0.0",
  "description": "正方教务系统 CLI 工具",
  "main": "dist/index.js",
  "bin": {
    "usts": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node tools/chmod-bin.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "capture": "node tools/capture-browser.mjs",
    "prepare": "node tools/prepare.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "README.md"
  ],
  "keywords": [
    "zhifang",
    "jwgl",
    "usts",
    "cli",
    "教务系统",
    "苏州科技大学",
    "grades",
    "timetable"
  ],
  "author": "mico-v",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mico-v/usts-cli.git"
  },
  "homepage": "https://github.com/mico-v/usts-cli#readme",
  "bugs": {
    "url": "https://github.com/mico-v/usts-cli/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^15.0.0",
    "inquirer": "^8.2.7"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.13",
    "@types/node": "^26.1.2",
    "puppeteer": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
